{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "RULE-AMOUNT-USD-10000",
      "name": "High-value USD debit",
      "type": "AMOUNT_THRESHOLD",
      "severity": "HIGH",
      "active": true,
      "config": {
        "schemaVersion": 1,
        "currency": "USD",
        "threshold": "10000.00",
        "transactionTypes": [
          "DEBIT"
        ]
      }
    },
    {
      "id": "RULE-VELOCITY-10M-5",
      "name": "More than 5 debits in 10 minutes",
      "type": "VELOCITY",
      "severity": "HIGH",
      "active": true,
      "config": {
        "schemaVersion": 1,
        "timeWindowSeconds": 600,
        "maxTransactionCount": 5,
        "transactionTypes": [
          "DEBIT"
        ]
      }
    },
    {
      "id": "RULE-NEW-PAYEE",
      "name": "First completed debit to payee",
      "type": "NEW_PAYEE",
      "severity": "MEDIUM",
      "active": true,
      "config": {
        "schemaVersion": 1,
        "transactionTypes": [
          "DEBIT"
        ]
      }
    },
    {
      "id": "RULE-DAILY-USD-50000",
      "name": "Daily USD debit total above 50,000",
      "type": "DAILY_LIMIT",
      "severity": "HIGH",
      "active": true,
      "config": {
        "schemaVersion": 1,
        "currency": "USD",
        "dailyLimit": "50000.00",
        "transactionTypes": [
          "DEBIT"
        ]
      }
